<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Jenis Permukaan -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="☑"
                        android:textSize="18sp"
                        android:textColor="@color/primary_green"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Permukaan *"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Checkbox Grid 2 kolom -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                    <CheckBox
                        android:id="@+id/cbRumputSintetis"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Rumput Sintetis"
                        android:textSize="14sp"
                        android:textColor="#121212"
                        android:buttonTint="@color/primary_green"
                        android:paddingStart="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cbParquet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Parquet"
                        android:textSize="14sp"
                        android:textColor="#121212"
                        android:buttonTint="@color/primary_green"
                        android:paddingStart="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cbVinyl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Vinyl"
                        android:textSize="14sp"
                        android:textColor="#121212"
                        android:buttonTint="@color/primary_green"
                        android:paddingStart="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cbSemen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Semen"
                        android:textSize="14sp"
                        android:textColor="#121212"
                        android:buttonTint="@color/primary_green"
                        android:paddingStart="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Harga & Operasional -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="$"
                        android:textSize="16sp"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga &amp; Operasional"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Jumlah Lapangan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Lapangan"
                    android:textSize="13sp"
                    android:textColor="#121212"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxStrokeColor="@color/divider">

                    <AutoCompleteTextView
                        android:id="@+id/actvJumlahLapangan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1 Lapangan"
                        android:textSize="14sp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:focusable="false"
                        android:clickable="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Harga per Jam -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harga per Jam *"
                    android:textSize="13sp"
                    android:textColor="#121212"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxStrokeColor="@color/divider"
                    app:prefixText="Rp  ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHargaPerJam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="80.000"
                        android:textSize="14sp"
                        android:inputType="numberDecimal"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Jam Buka & Tutup -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕐"
                                android:textSize="13sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Jam Buka"
                                android:textSize="13sp"
                                android:textColor="#121212"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/divider">

                            <AutoCompleteTextView
                                android:id="@+id/actvJamBuka"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="06:00"
                                android:textSize="14sp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕐"
                                android:textSize="13sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Jam Tutup"
                                android:textSize="13sp"
                                android:textColor="#121212"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/divider">

                            <AutoCompleteTextView
                                android:id="@+id/actvJamTutup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="23:00"
                                android:textSize="14sp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Fasilitas Tersedia -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="☆"
                        android:textSize="18sp"
                        android:textColor="@color/primary_green"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fasilitas Tersedia"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Grid Fasilitas -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="false">

                    <CheckBox android:id="@+id/cbParkir" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Parkir Luas" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbToilet" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Toilet" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbRuangGanti" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Ruang Ganti" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbKantin" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Kantin" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbWifi" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="WiFi" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbCctv" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="CCTV" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>