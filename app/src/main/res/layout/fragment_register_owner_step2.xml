<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Jam Operasional -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="🕐"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jam Operasional Venue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jam operasional ini berlaku untuk semua lapangan di venue kamu"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jam Buka"
                            android:textSize="13sp"
                            android:textColor="#121212"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/divider">

                            <AutoCompleteTextView
                                android:id="@+id/actvJamBuka"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="06:00"
                                android:textSize="14sp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jam Tutup"
                            android:textSize="13sp"
                            android:textColor="#121212"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="@color/divider">

                            <AutoCompleteTextView
                                android:id="@+id/actvJamTutup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="23:00"
                                android:textSize="14sp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Fasilitas Tersedia -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="☆"
                        android:textSize="18sp"
                        android:textColor="@color/primary_green"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fasilitas Umum Venue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fasilitas yang tersedia untuk semua pengunjung venue"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="14dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="false">

                    <CheckBox android:id="@+id/cbParkir" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Parkir Luas" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbToilet" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Toilet" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbRuangGanti" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Ruang Ganti" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbKantin" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="Kantin" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbWifi" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="WiFi" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <CheckBox android:id="@+id/cbCctv" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="CCTV" android:textSize="14sp"
                        android:textColor="#121212" android:buttonTint="#00A86B"
                        android:paddingStart="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>