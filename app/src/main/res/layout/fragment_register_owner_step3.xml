<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Foto Utama -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="📷"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto Utama"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#121212"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto yang ditampilkan di halaman utama"
                            android:textSize="12sp"
                            android:textColor="#999999"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Preview Foto Utama -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:id="@+id/ivFotoUtama"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E8E8E8"/>

                    <!-- Overlay tombol ganti foto -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#CC000000"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↑"
                            android:textSize="16sp"
                            android:textColor="@color/white"/>

                        <TextView
                            android:id="@+id/tvGantiFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Ganti Foto"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- Keterangan -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto preview otomatis tersedia untuk demonstrasi"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Foto Galeri -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="📷"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto Galeri"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#121212"/>

                        <TextView
                            android:id="@+id/tvGaleriCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambahkan foto pendukung (0/4)"
                            android:textSize="12sp"
                            android:textColor="#999999"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Grid Galeri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Slot 1 -->
                    <FrameLayout
                        android:id="@+id/slotGaleri1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="#F0F0F0">
                        <ImageView
                            android:id="@+id/ivGaleri1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Slot 2 -->
                    <FrameLayout
                        android:id="@+id/slotGaleri2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="#F0F0F0">
                        <ImageView
                            android:id="@+id/ivGaleri2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Slot 3 -->
                    <FrameLayout
                        android:id="@+id/slotGaleri3"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="8dp"
                        android:background="#F0F0F0">
                        <ImageView
                            android:id="@+id/ivGaleri3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Slot 4 -->
                    <FrameLayout
                        android:id="@+id/slotGaleri4"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="#F0F0F0">
                        <ImageView
                            android:id="@+id/ivGaleri4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>

                </LinearLayout>

                <!-- Tombol Tambah -->
                <LinearLayout
                    android:id="@+id/btnTambahGaleri"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_galeri_add"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑"
                        android:textSize="20sp"
                        android:textColor="#999999"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Ringkasan Lapangan -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/primary_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Lapangan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    android:layout_marginBottom="12dp"/>

                <!-- Nama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Nama"
                        android:textSize="13sp" android:textColor="#A8D5B5"/>
                    <TextView android:id="@+id/tvSummaryNama"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="-" android:textSize="13sp" android:textColor="@color/text_on_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Kota -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Kota"
                        android:textSize="13sp" android:textColor="#A8D5B5"/>
                    <TextView android:id="@+id/tvSummaryKota"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bandung" android:textSize="13sp" android:textColor="@color/text_on_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Lapangan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Lapangan"
                        android:textSize="13sp" android:textColor="#A8D5B5"/>
                    <TextView android:id="@+id/tvSummaryLapangan"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="-" android:textSize="13sp" android:textColor="@color/text_on_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Harga -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Harga"
                        android:textSize="13sp" android:textColor="#A8D5B5"/>
                    <TextView android:id="@+id/tvSummaryHarga"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="-" android:textSize="13sp" android:textColor="@color/text_on_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Operasional -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Operasional"
                        android:textSize="13sp" android:textColor="#A8D5B5"/>
                    <TextView android:id="@+id/tvSummaryOperasional"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="-" android:textSize="13sp" android:textColor="@color/text_on_primary"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>