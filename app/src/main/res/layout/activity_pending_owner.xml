<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F5F5F5">

    <!-- Ikon menunggu -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="⏳"
        android:textSize="48sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pendaftaran Terkirim!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#121212"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data lapangan Anda sedang dalam proses verifikasi oleh tim FindFutsall."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anda akan mendapat notifikasi jika sudah disetujui dan diminta login ulang."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="40dp"/>

    <!-- Status card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E8FFF5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Pendaftaran"
                    android:textSize="12sp"
                    android:textColor="#666666"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menunggu Verifikasi"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A4D2E"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tombol kembali -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKembali"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Kembali ke Beranda"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:backgroundTint="#1A4D2E"
        app:cornerRadius="12dp"/>

</LinearLayout>