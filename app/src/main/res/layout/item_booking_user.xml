<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookingFieldName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Lapangan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A2E1A"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvBookingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvBookingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waktu"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvBookingTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A4D2E"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menunggu"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="@drawable/bg_status_selesai"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>