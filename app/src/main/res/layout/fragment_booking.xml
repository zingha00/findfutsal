<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#00A86B"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Bandung, ID"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#121212"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_notification"/>

    </LinearLayout>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesanan Saya"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#121212"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Riwayat dan status booking lapangan kamu."
            android:textSize="12sp"
            android:textColor="#999999"/>

    </LinearLayout>

    <!-- Filter Status -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSemua"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Semua"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_active"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipMenunggu"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Menunggu"
                android:textSize="13sp"
                android:textColor="#121212"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_inactive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipDikonfirmasi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Dikonfirmasi"
                android:textSize="13sp"
                android:textColor="#121212"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_inactive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipSelesai"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Selesai"
                android:textSize="13sp"
                android:textColor="#121212"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_inactive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipDibatalkan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Dibatalkan"
                android:textSize="13sp"
                android:textColor="#121212"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_chip_inactive"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_booking"
            app:tint="#E0E0E0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Belum ada pesanan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#121212"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Booking lapangan favoritmu sekarang!"
            android:textSize="13sp"
            android:textColor="#999999"/>

    </LinearLayout>

    <!-- Booking List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBooking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

</LinearLayout>