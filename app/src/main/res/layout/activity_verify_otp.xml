<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <View
        android:id="@+id/heroBg"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_auth_hero"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_arrow_left"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Kembali"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/heroBg"
        app:layout_constraintStart_toStartOf="@id/heroBg" />

    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verifikasi Kode OTP"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="@id/heroBg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masukkan kode yang kami kirim"
        android:textSize="13sp"
        android:textColor="#CCFFFFFF"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="@id/heroBg" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Card.TopRounded"
        app:layout_constraintTop_toBottomOf="@id/heroBg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="28dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock"
                    android:background="#E8FFF5"
                    android:padding="20dp"
                    android:tint="@color/primary_green"
                    android:contentDescription="OTP"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="Masukkan Kode OTP"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvEmailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="Kode telah dikirim ke email kamu"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <!-- 6 Kotak OTP terpisah -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <EditText
                        android:id="@+id/etOtp1"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:cursorVisible="true"
                        android:importantForAutofill="no"/>

                    <EditText
                        android:id="@+id/etOtp2"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:importantForAutofill="no"/>

                    <EditText
                        android:id="@+id/etOtp3"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:importantForAutofill="no"/>

                    <EditText
                        android:id="@+id/etOtp4"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:importantForAutofill="no"/>

                    <EditText
                        android:id="@+id/etOtp5"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:importantForAutofill="no"/>

                    <EditText
                        android:id="@+id/etOtp6"
                        android:layout_width="44dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:importantForAutofill="no"/>

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Verifikasi"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    android:backgroundTint="@color/primary_green"
                    app:cornerRadius="14dp" />

                <TextView
                    android:id="@+id/tvResendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="Kirim Ulang Kode OTP"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>