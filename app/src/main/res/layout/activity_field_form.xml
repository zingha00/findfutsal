<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_dark"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left"
            android:tint="#FFFFFF"
            android:contentDescription="Kembali"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Tambah Lapangan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:indeterminateTint="#FFFFFF"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Foto Lapangan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Foto Lapangan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <FrameLayout
                        android:id="@+id/framePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#F5F5F5"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>

                        <LinearLayout
                            android:id="@+id/layoutUploadHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_search"
                                app:tint="#CCCCCC"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ketuk untuk upload foto"
                                android:textSize="13sp"
                                android:textColor="#999999"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Format JPG, PNG (Maks. 5MB)"
                                android:textSize="11sp"
                                android:textColor="#BBBBBB"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvGantiFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:text="Ganti Foto"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="#AA000000"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"/>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Info Dasar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Dasar"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="14dp"/>

                    <!-- Nama Lapangan -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Nama Lapangan *" android:textSize="12sp"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="#E0E0E0">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Contoh: Lapangan Emerald A"
                            android:textSize="14sp" android:inputType="textCapWords"
                            android:paddingTop="14dp" android:paddingBottom="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Alamat -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Alamat *" android:textSize="12sp"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="#E0E0E0">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAlamat"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Jl. Contoh No. 123"
                            android:textSize="14sp" android:inputType="textMultiLine"
                            android:minLines="2" android:paddingTop="14dp" android:paddingBottom="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Telepon -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Nomor Telepon" android:textSize="12sp"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="#E0E0E0">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelepon"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="+62 812-3456-7890"
                            android:textSize="14sp" android:inputType="phone"
                            android:paddingTop="14dp" android:paddingBottom="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Deskripsi -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Deskripsi" android:textSize="12sp"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="#E0E0E0">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeskripsi"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Deskripsikan keunggulan lapangan Anda..."
                            android:textSize="14sp" android:inputType="textMultiLine"
                            android:minLines="3" android:gravity="top"
                            android:paddingTop="14dp" android:paddingBottom="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Harga & Operasional -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga &amp; Operasional"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="14dp"/>

                    <!-- Harga -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Harga per Jam *" android:textSize="12sp"
                        android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="#E0E0E0"
                        app:prefixText="Rp  ">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHarga"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="80.000"
                            android:textSize="14sp" android:inputType="numberDecimal"
                            android:paddingTop="14dp" android:paddingBottom="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Jam Buka & Tutup -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Jam Buka" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                                app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                                app:boxStrokeColor="#E0E0E0">
                                <AutoCompleteTextView
                                    android:id="@+id/actvJamBuka"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="06:00" android:textSize="14sp"
                                    android:paddingTop="14dp" android:paddingBottom="14dp"
                                    android:focusable="false" android:clickable="true"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Jam Tutup" android:textSize="12sp"
                                android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp"
                                app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp"
                                app:boxStrokeColor="#E0E0E0">
                                <AutoCompleteTextView
                                    android:id="@+id/actvJamTutup"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="23:00" android:textSize="14sp"
                                    android:paddingTop="14dp" android:paddingBottom="14dp"
                                    android:focusable="false" android:clickable="true"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Jenis Permukaan & Fasilitas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Permukaan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:columnCount="2" android:layout_marginBottom="16dp">
                        <CheckBox android:id="@+id/cbRumputSintetis" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Rumput Sintetis" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbParquet" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Parquet" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbVinyl" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Vinyl" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbSemen" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Semen" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                    </GridLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fasilitas Tersedia"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:columnCount="2">
                        <CheckBox android:id="@+id/cbParkir" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Parkir Luas" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbToilet" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Toilet" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbRuangGanti" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Ruang Ganti" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbKantin" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="Kantin" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbWifi" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="WiFi" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        <CheckBox android:id="@+id/cbCctv" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_columnWeight="1"
                            android:text="CCTV" android:textSize="13sp"
                            android:buttonTint="#00A86B" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tombol Simpan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Simpan Lapangan"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_dark"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>