<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Export Laporan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A2E1A"/>

        <ImageView
            android:id="@+id/popupBtnClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="#666666"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unduh laporan keuangan dalam format PDF"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dari Tanggal"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/popupDateFrom"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_otp_box"
        android:textSize="13sp"
        android:textColor="#121212"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sampai Tanggal"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/popupDateTo"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_otp_box"
        android:textSize="13sp"
        android:textColor="#121212"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jenis Laporan"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <!-- Pilihan jenis laporan jadi 3 chip rapi, ganti Spinner default yang kaku -->
    <LinearLayout
        android:id="@+id/layoutJenisLaporan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/popupBtnPdf"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Export PDF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_primary"
        android:textAllCaps="false"
        android:backgroundTint="@color/primary_green"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_download"
        app:iconTint="@color/text_on_primary"/>

</LinearLayout>