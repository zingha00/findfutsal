<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_export"
    android:padding="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Laporan"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textColor="#121212"
        android:layout_marginBottom="16dp" />

    <!-- Dari & Sampai dalam 1 baris -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dari Tanggal"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/popupDateFrom"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_field"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textColor="#121212"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sampai Tanggal"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/popupDateTo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input_field"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textColor="#121212"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Jenis Laporan -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jenis Laporan"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerJenisLaporan"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="14dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupBtnPdf"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="⬇ Export PDF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#FF3B30"
            app:cornerRadius="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupBtnExcel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="⬇ Export Excel"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#00A86B"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>