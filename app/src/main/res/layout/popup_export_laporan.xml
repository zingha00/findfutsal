<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Laporan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#121212"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dari Tanggal"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/popupDateFrom"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_chip_inactive"
        android:textSize="12sp"
        android:textColor="#121212"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sampai Tanggal"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/popupDateTo"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_chip_inactive"
        android:textSize="12sp"
        android:textColor="#121212"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jenis Laporan"
        android:textSize="11sp"
        android:textColor="#999999"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerJenisLaporan"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupBtnPdf"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Export PDF"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#FF3B30"
            app:cornerRadius="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupBtnExcel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Export Excel"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#00A86B"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>