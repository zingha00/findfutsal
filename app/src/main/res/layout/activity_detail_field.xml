<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto + Tombol Atas -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/ivFieldPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/findfutsall"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_photo_gradient"/>

                <!-- Top buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="44dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_arrow_left"
                        android:background="@drawable/bg_favorite_btn"
                        android:padding="8dp"
                        android:contentDescription="Kembali"/>

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/btnFavorite"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_favorite"
                        android:background="@drawable/bg_favorite_btn"
                        android:padding="8dp"
                        app:tint="@color/white"/>
                </LinearLayout>

                <!-- Badge harga di bawah foto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFieldName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Lapangan"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_location"
                                app:tint="#CCFFFFFF"
                                android:layout_marginEnd="4dp"/>

                            <TextView
                                android:id="@+id/tvAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alamat"
                                android:textSize="12sp"
                                android:textColor="#CCFFFFFF"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rating -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_rating"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★"
                            android:textSize="12sp"
                            android:textColor="#FFD700"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Tags + Jam Buka -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Vinyl"
                            android:textColor="@color/primary_green"
                            android:textSize="11sp"/>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_notification"
                            app:tint="@color/primary_green"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:id="@+id/tvJamBuka"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buka 06:00 - 23:00"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="14dp"/>

                    <!-- Fasilitas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fasilitas"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/layoutFasilitas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>

                    <!-- Deskripsi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tentang Lapangan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pilih Tanggal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pilih Tanggal"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#121212"/>

                        <TextView
                            android:id="@+id/tvSelectedMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="@color/primary_green"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Date Pills (horizontal scroll) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutDatePills"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pilih Jam -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPilihJam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="0dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Jam"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginBottom="12dp"/>

                    <androidx.gridlayout.widget.GridLayout
                        android:id="@+id/gridTimeSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:columnCount="2"
                        app:useDefaultMargins="false"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rincian Harga -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRincian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rincian Harga"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Sewa Lapangan"
                            android:textSize="13sp" android:textColor="#666666"/>
                        <TextView android:id="@+id/tvRincianSewa"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rp 0" android:textSize="13sp" android:textColor="#121212"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Biaya Layanan"
                            android:textSize="13sp" android:textColor="#666666"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rp 5.000" android:textSize="13sp" android:textColor="#121212"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Total Bayar"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="#121212"/>
                        <TextView android:id="@+id/tvTotalRincian"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rp 0" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="@color/primary_green"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hidden views untuk compatibility -->
            <LinearLayout android:id="@+id/containerBooking" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
            <LinearLayout android:id="@+id/containerTimeSlots" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
            <TextView android:id="@+id/tvPriceWeekday" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"/>
            <TextView android:id="@+id/tvPriceWeekend" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"/>
            <TextView android:id="@+id/tvReviewCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvReviews"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <Button android:id="@+id/btnSearch" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"/>
            <Button android:id="@+id/btnPilihJadwal" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardHarga"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardPilihJadwal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate" android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MULAI DARI"
                android:textSize="10sp"
                android:textColor="#999999"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0 / jam"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#121212"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Booking Sekarang"
            android:textSize="14sp"
            android:textColor="@color/text_on_primary"
            app:backgroundTint="@color/primary_green"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_arrow_left"
            app:iconTint="@color/text_on_primary"
            app:iconGravity="end"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>