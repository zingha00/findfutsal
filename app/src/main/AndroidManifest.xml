<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.utama.findfutsall">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FindFutsall">

        <!-- Splash Screen -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FindFutsall.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Main -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Detail Lapangan -->
        <activity
            android:name=".ui.detail.DetailFieldActivity"
            android:exported="false"/>

        <!-- Payment -->
        <activity
            android:name=".ui.detail.PaymentActivity"
            android:exported="false"/>

        <!-- Payment Instruction -->
        <activity
            android:name=".ui.detail.PaymentInstructionActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.owner.RegisterOwnerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.owner.PendingOwnerActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.owner.OwnerDashboardActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.owner.OwnerFieldFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.owner.FieldFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ui.detail.BookingSuccessActivity"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>